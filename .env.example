DATABASE_URL=postgresql://sacm:sacm@localhost:5432/sacm
REDIS_URL=redis://localhost:6379
SACM_POSTGRES_PASSWORD=sacm-local-only

OPENAI_API_KEY=
ANTHROPIC_API_KEY=

DEFAULT_EMBEDDING_PROVIDER=openai
DEFAULT_EMBEDDING_DIM=1536

# Opt-in LangSmith telemetry. Only task IDs and operational metadata are traced.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=sacm-agent-runtime

# Opt-in OpenTelemetry traces and metrics. Configure a standard OTLP/HTTP collector
# through OTEL_EXPORTER_OTLP_ENDPOINT (for example, http://localhost:4318).
SACM_OTEL_ENABLED=false
OTEL_SERVICE_NAME=sacm-agent-runtime
OTEL_EXPORTER_OTLP_ENDPOINT=
# Set this to the current provider price before using estimated-cost metrics.
SACM_OPENAI_EMBEDDING_INPUT_COST_PER_MILLION_USD=
# Configure these only when Codex reports token usage in JSON output.
SACM_CODEX_INPUT_COST_PER_MILLION_USD=
SACM_CODEX_OUTPUT_COST_PER_MILLION_USD=

# Opt-in MLflow runs emitted by MLflowExperimentAgent. Install with .[mlflow].
SACM_MLFLOW_ENABLED=false
MLFLOW_TRACKING_URI=
SACM_MLFLOW_EXPERIMENT=sacm-router

# Mobile E2E runs are opt-in because they require a booted simulator or device.
SACM_RUN_MOBILE_E2E=false

# Opt-in Agent SDK reasoning. Install with .[agents] and set OPENAI_API_KEY.
SACM_OPENAI_AGENTS_ENABLED=false
SACM_OPENAI_AGENTS_MODEL=
SACM_OPENAI_AGENTS_INPUT_COST_PER_MILLION_USD=
SACM_OPENAI_AGENTS_OUTPUT_COST_PER_MILLION_USD=

# A Codex task creates a pull request only after Codex and all configured
# verification commands succeed. GitHub branch protection still controls merge.
SACM_CODEX_AUTO_CREATE_PR=false
SACM_GITHUB_BASE_BRANCH=main
# GitHub issue-label webhook trigger. Map only approved GitHub repositories to local paths.
SACM_GITHUB_WEBHOOK_SECRET=
SACM_GITHUB_TRIGGER_LABEL=sacm
SACM_GITHUB_REPOSITORIES_JSON={}
SACM_GITHUB_APP_ID=
SACM_GITHUB_APP_PRIVATE_KEY_PATH=
SACM_GITHUB_API_URL=https://api.github.com

# Tool policy. OPA is fail-closed by default; omit SACM_OPA_URL to use the
# explicit local allow/deny and approval action lists.
SACM_OPA_URL=
SACM_OPA_FAIL_CLOSED=true
SACM_DENIED_TOOL_ACTIONS=
SACM_APPROVAL_REQUIRED_ACTIONS=

# Evidence signatures are emitted only when this key is explicitly configured.
SACM_EVIDENCE_HMAC_KEY=
SACM_DOCKER_RUNTIME=runc
SACM_AUTH_REQUIRED=false
SACM_OIDC_ISSUER=
SACM_OIDC_AUDIENCE=
SACM_OIDC_JWKS_URL=

# Workflow backend. Temporal requires installation with .[temporal] and a
# separately started `sacm-temporal-worker`.
SACM_WORKFLOW_BACKEND=local
SACM_TEMPORAL_ADDRESS=localhost:7233
SACM_TEMPORAL_NAMESPACE=default
SACM_TEMPORAL_TASK_QUEUE=sacm-runs

SACM_WORKTREE_ROOT=./worktrees
SACM_MAX_AGENT_STEPS=10
SACM_DEFAULT_TOKEN_BUDGET=12000

SACM_FSM_PATH=./sacm_fsm.json
SACM_FSM_ALPHA=0.1
SACM_CONTEXT_AGENT_MAX_STEPS=6

# MCP bridge settings
SACM_API_URL=http://127.0.0.1:8000
