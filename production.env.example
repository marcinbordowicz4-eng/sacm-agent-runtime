ACME_EMAIL=admin@sacm.io
SACM_OIDC_ISSUER=
SACM_OIDC_AUDIENCE=sacm-api
SACM_OIDC_JWKS_URL=
SACM_HOST_REPOSITORY_ROOT=/opt/sacm/repositories
SACM_EVIDENCE_ROOT=/app/.sacm/evidence
SACM_WORKFLOW_BACKEND=remote
SACM_APPROVED_SANDBOX_RUNTIMES=runsc
SACM_SECRET_PROVIDER=vault
SACM_APPROVED_SECRET_PROVIDERS=vault
SACM_CREDENTIAL_LEASE_MAX_SECONDS=300
SACM_EXECUTION_LEASE_SECONDS=120
SACM_REMOTE_REQUIRED_CAPABILITIES=agent-task/v1
SACM_TEMPORAL_ADDRESS=temporal:7233
SACM_TEMPORAL_NAMESPACE=default
SACM_TEMPORAL_TASK_QUEUE=sacm-runs
SACM_PLATFORM_ADMIN_SUBJECTS=
SACM_EVIDENCE_SIGNING_KEY_ID=production-evidence-v1
SACM_AUDIT_EXPORT_SIGNING_PRIVATE_KEY_FILE=/run/secrets/audit_export_signing_key
SACM_AUDIT_EXPORT_SIGNING_KEY_ID=production-audit-export-v1
SACM_DEFAULT_DATA_REGION=eu-west-1
SACM_CUSTOMER_EXECUTOR_ALLOWED_REGIONS=eu-west-1,eu-central-1
SACM_EXECUTOR_CURRENT_VERSION=1.0.0
SACM_EXECUTOR_MINIMUM_VERSION=1.0.0
SACM_EXECUTOR_RELEASED_AT=2026-01-01T00:00:00Z
SACM_EXECUTOR_AVAILABILITY_SLO=0.99
SACM_OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
SACM_BACKUP_ROOT=/backups
SACM_BACKUP_MAX_AGE_SECONDS=86400
SACM_BACKUP_DB_HOST=
SACM_BACKUP_DB_PORT=5432
SACM_BACKUP_DB_USER=
SACM_BACKUP_DB_PASSWORD_FILE=/run/secrets/postgres_password
SACM_RESTORE_DB_HOST=
SACM_RESTORE_DB_PORT=5432
SACM_RESTORE_DB_USER=
SACM_RESTORE_DB_PASSWORD_FILE=/run/secrets/postgres_password
SACM_BACKUP_AGE_RECIPIENTS_FILE=/run/secrets/backup_age_recipients
SACM_BACKUP_AGE_IDENTITY_FILE=/run/secrets/backup_age_identity
SACM_BACKUP_ENCRYPTION_KEY_ID=production-backup-v1
SACM_DESTRUCTIVE_RESTORE_GUARD_FILE=/run/secrets/destructive_restore_guard
SACM_HEALTH_REDIS_REQUIRED=true
SACM_HEALTH_OPA_REQUIRED=true
